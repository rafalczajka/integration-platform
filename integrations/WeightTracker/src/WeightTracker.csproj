<Project Sdk="Azure.Functions.Sdk">

  <PropertyGroup>
    <AssemblyName>Integrations.WeightTracker</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <RefitRequireGeneratedRequests>true</RefitRequireGeneratedRequests>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
  </ItemGroup>

</Project>
